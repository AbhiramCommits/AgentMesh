# AgentMesh configuration. Copy to .env and edit as needed.

# --- Data stores -----------------------------------------------------------
# Use 5433/6380 because the docker-compose host ports are remapped to avoid
# clashing with other local Postgres/Redis instances.
DATABASE_URL=postgresql+asyncpg://agentmesh:agentmesh@localhost:5433/agentmesh
REDIS_URL=redis://localhost:6380/0

# --- LLM provider ----------------------------------------------------------
# provider = "fake" runs fully offline with no API key (default).
# provider = "openai" uses any OpenAI-compatible endpoint.
AGENTMESH_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AGENTMESH_MODEL=gpt-4o-mini
AGENTMESH_FALLBACK_MODEL=gpt-4o
AGENTMESH_EMBEDDING_DIM=256

# --- Runtime ---------------------------------------------------------------
AGENTMESH_SANDBOX_ROOT=
AGENTMESH_LOG_LEVEL=INFO
AGENTMESH_CRASH_AT_NODE=
AGENTMESH_MAX_CONCURRENCY=8

# --- API -------------------------------------------------------------------
AGENTMESH_API_HOST=0.0.0.0
AGENTMESH_API_PORT=8000
AGENTMESH_CORS_ORIGINS=http://localhost:5173
